# ==============================================================================
# PATOLA FRONTEND ENVIRONMENT VARIABLES (.env)
# ==============================================================================

# API Backend Base URL (leave empty or set to /api for local Vite proxy; 
# for production cloud deployment, set your backend domain e.g. https://api.patolahandmadebyvankar.com/api)
VITE_API_BASE_URL=/api

# Google Analytics 4 Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Production Domain
VITE_SITE_URL=https://patolahandmadebyvankar.com

# Razorpay Public Key ID (for online checkout)
VITE_RAZORPAY_KEY_ID=

