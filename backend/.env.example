# ==============================================================================
# PATOLA .NET CORE BACKEND ENVIRONMENT VARIABLES (.env)
# ==============================================================================
# In ASP.NET Core, nested JSON configuration keys are overridden in production 
# by Environment Variables using double-underscore (__) separator.

# ASP.NET Environment ('Development' or 'Production')
ASPNETCORE_ENVIRONMENT=Production

# Server URLs (Port to listen on)
ASPNETCORE_URLS=http://+:5285

# SQL Server Database Connection String
ConnectionStrings__SqlServerConnection=Server=localhost;Database=VirasatPatolaDb;User Id=sa;Password=YourSecureSqlPassword123!;TrustServerCertificate=True;MultipleActiveResultSets=true;

# JWT Authentication (MUST be at least 32 characters in production)
JwtSettings__SecretKey=YourSuperSecretProductionJwtKey32CharsLongMin!2026
JwtSettings__Issuer=VirasatPatolaApi
JwtSettings__Audience=VirasatPatolaClient
JwtSettings__ExpiryHours=24

# Admin Panel Credentials
AdminCredentials__Username=admin
AdminCredentials__Password=YourComplexAdminPassword@2026

# Razorpay Payment Gateway (Live or Test keys)
RazorpaySettings__KeyId=rzp_live_xxxxxxxxxxxxx
RazorpaySettings__KeySecret=xxxxxxxxxxxxxxxxxxxxxx
RazorpaySettings__TestMode=false
RazorpaySettings__MerchantName=PATOLA - Handmade by Vankar

# Virtual Try-On AI Service (Optional - Replicate / Fashn AI)
VirtualTryOn__ApiKey=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VirtualTryOn__Provider=Replicate

# Allowed CORS Origins (Comma-separated in production)
CORS_ALLOWED_ORIGINS=https://patolahandmadebyvankar.com,https://www.patolahandmadebyvankar.com

